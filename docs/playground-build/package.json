{
  "name": "meaning-playground-build",
  "private": true,
  "description": "Builds the vendored CodeMirror bundle for the docs playground (docs/src/playground/vendor/codemirror.js). Run via `task playground:vendor`; commit the output.",
  "scripts": {
    "build": "esbuild src/editor.js --bundle --format=esm --minify --outfile=../src/playground/vendor/codemirror.js"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@codemirror/theme-one-dark": "^6.1.3",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
