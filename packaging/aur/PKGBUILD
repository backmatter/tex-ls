# Maintainer: Johan Larsson <johan@jolars.co>
pkgname=meaning-bin
pkgver=0.13.0
pkgrel=1
pkgdesc="A language server, formatter, and linter for LaTeX"
arch=('x86_64' 'aarch64')
url="https://github.com/backmatter/meaning"
license=('MIT')
depends=('gcc-libs')
provides=('meaning')
conflicts=('meaning')
options=(!strip)
source_x86_64=("meaning-$pkgver-x86_64-unknown-linux-gnu.tar.gz::$url/releases/download/v$pkgver/meaning-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("meaning-$pkgver-aarch64-unknown-linux-gnu.tar.gz::$url/releases/download/v$pkgver/meaning-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('5a9e9bfbcb11c535863350994f15a26cf8c7f3eb29681ceda65b88a2cee38b95')
sha256sums_aarch64=('b2026fffeb84437640fb44dc8dae3f721094a64f26cac681ecd543dcbbf9b924')

package() {
    install -Dm755 meaning "$pkgdir/usr/bin/meaning"

    # Release tarballs up to v0.13.0 predate the man-page and completion
    # bundling; the guards can go once pkgver is past that.
    if [ -d man ]; then
        install -Dm644 man/*.1 -t "$pkgdir/usr/share/man/man1/"
    fi

    if [ -d completions ]; then
        install -Dm644 completions/meaning.bash "$pkgdir/usr/share/bash-completion/completions/meaning"
        install -Dm644 completions/meaning.fish "$pkgdir/usr/share/fish/vendor_completions.d/meaning.fish"
        install -Dm644 completions/_meaning "$pkgdir/usr/share/zsh/site-functions/_meaning"
    fi

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
