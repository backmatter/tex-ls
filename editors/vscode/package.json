{
  "name": "tex-ls",
  "displayName": "tex-ls",
  "description": "LaTeX and BibTeX completion, navigation, formatting, and linting.",
  "version": "0.1.4",
  "publisher": "backmatter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/backmatter/tex-ls.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "latex",
    "tex",
    "bibtex",
    "lsp"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "tex-ls requires a trusted workspace to read project files and run installed-package discovery."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "tex-ls requires access to a native filesystem."
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test test/unit.test.cjs",
    "test:integration": "npm run compile && node test/run.cjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "^5.9.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "latex",
        "aliases": [
          "LaTeX",
          "latex"
        ],
        "extensions": [
          ".tex",
          ".ltx",
          ".sty",
          ".cls",
          ".clo",
          ".dtx",
          ".def",
          ".lco",
          ".bbx",
          ".cbx",
          ".lbx"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "bibtex",
        "aliases": [
          "BibTeX",
          "bibtex"
        ],
        "extensions": [
          ".bib",
          ".bibtex"
        ],
        "configuration": "./bibtex-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "latex",
        "scopeName": "text.tex.latex",
        "path": "./syntaxes/latex.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.c.latex": "c",
          "meta.embedded.block.cpp.latex": "cpp",
          "meta.embedded.block.javascript.latex": "javascript",
          "meta.embedded.block.typescript.latex": "typescript",
          "meta.embedded.block.json.latex": "json",
          "meta.embedded.block.css.latex": "css",
          "meta.embedded.block.html.latex": "html"
        }
      },
      {
        "language": "bibtex",
        "scopeName": "text.bibtex",
        "path": "./syntaxes/bibtex.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[latex]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[bibtex]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "texText:latex": {
            "bold": false,
            "italic": false
          },
          "*.texBold:latex": {
            "bold": true
          },
          "*.texItalic:latex": {
            "italic": true
          },
          "*.declaration:latex": {
            "bold": true
          },
          "texText:bibtex": {
            "bold": false,
            "italic": false
          },
          "*.texBold:bibtex": {
            "bold": true
          },
          "*.texItalic:bibtex": {
            "italic": true
          },
          "*.declaration:bibtex": {
            "bold": true
          }
        }
      }
    },
    "commands": [
      {
        "command": "tex-ls.fixAll",
        "title": "Fix All Safe Issues",
        "category": "tex-ls",
        "enablement": "editorLangId == latex || editorLangId == bibtex"
      },
      {
        "command": "tex-ls.showProject",
        "title": "Inspect Project",
        "category": "tex-ls",
        "enablement": "resourceScheme == file && (editorLangId == latex || editorLangId == bibtex)"
      },
      {
        "command": "tex-ls.restartServer",
        "title": "Restart Language Server",
        "category": "tex-ls"
      },
      {
        "command": "tex-ls.showOutput",
        "title": "Show Language Server Output",
        "category": "tex-ls"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tex-ls.fixAll",
          "when": "editorLangId == latex || editorLangId == bibtex"
        },
        {
          "command": "tex-ls.showProject",
          "when": "resourceScheme == file && (editorLangId == latex || editorLangId == bibtex)"
        }
      ]
    },
    "configuration": {
      "title": "tex-ls",
      "properties": {
        "tex-ls.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path or executable name for tex-ls. Empty uses the bundled server. Arguments are not accepted. Changes restart the server."
        },
        "tex-ls.trace.server": {
          "type": "string",
          "enum": [
            "messages",
            "verbose"
          ],
          "default": "messages",
          "scope": "window",
          "description": "Protocol detail when the tex-ls output channel log level is Trace. Use Developer: Set Log Level to enable tracing."
        },
        "tex-ls.lineWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 80,
          "scope": "resource",
          "description": "Fallback line width when no tex-ls.toml is found."
        },
        "tex-ls.indentWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 2,
          "scope": "resource",
          "description": "Fallback indentation width. Project configuration and formatting request tab size take precedence."
        },
        "tex-ls.texmf.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "description": "Discover installed TeX packages. Changes restart the server."
        },
        "tex-ls.texmf.roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Additional TEXMF directories, ahead of automatic discovery. Relative paths resolve against the workspace folder supplying the setting. Contents refresh automatically."
        },
        "tex-ls.texmf.useKpsewhich": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "description": "Use kpsewhich for installed-package discovery. Changes restart the server."
        },
        "tex-ls.outline": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": false,
          "description": "Choose which document symbols appear in the outline.",
          "properties": {
            "sections": {
              "type": "boolean"
            },
            "frames": {
              "type": "boolean"
            },
            "floats": {
              "type": "boolean"
            },
            "theorems": {
              "type": "boolean"
            },
            "labels": {
              "type": "boolean"
            },
            "macros": {
              "type": "boolean"
            },
            "environments": {
              "type": "boolean"
            },
            "labelledEquations": {
              "type": "boolean"
            },
            "unlabelledEquations": {
              "type": "boolean"
            },
            "items": {
              "type": "boolean"
            },
            "environmentNames": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "tex-ls.inlayHints": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": false,
          "description": "Show label information from source or the last build.",
          "properties": {
            "definitions": {
              "type": "boolean"
            },
            "references": {
              "type": "boolean"
            },
            "sourceContext": {
              "type": "boolean",
              "default": false,
              "description": "Show source section or caption descriptions when no compiled number is available."
            },
            "pages": {
              "type": "boolean",
              "default": false,
              "description": "Show last-build page numbers for page references."
            },
            "names": {
              "type": "boolean",
              "default": false,
              "description": "Show last-build names for name references."
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          }
        },
        "tex-ls.texmf.explicitOnly": {
          "type": "boolean",
          "default": false,
          "scope": "machine-overridable",
          "description": "Index only texmf.roots. Ignore kpsewhich, system fallback paths, and inherited TEXINPUTS. Useful for pinned or project-local toolchains."
        },
        "tex-ls.diagnostics.compiler": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Publish compiler-log diagnostics. Disable when another build integration supplies them; source linting and AUX information remain enabled."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "texText",
        "description": "Ordinary prose, math operands, and printed BibTeX values."
      },
      {
        "id": "texLiteral",
        "description": "Literal contents with inactive TeX syntax."
      },
      {
        "id": "texPath",
        "description": "A resource path, URL, or DOI."
      },
      {
        "id": "texMath",
        "description": "Proven math or alignment structure."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "texBold",
        "description": "Bold prose in a heading or textbf argument."
      },
      {
        "id": "texItalic",
        "description": "Emphasized prose."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "latex",
        "scopes": {
          "texText": [
            "text.tex.latex",
            "meta.embedded"
          ],
          "texLiteral": [
            "markup.raw",
            "meta.embedded"
          ],
          "texPath": [
            "string.other.path"
          ],
          "texMath": [
            "keyword.operator"
          ],
          "macro": [
            "entity.name.function.preprocessor"
          ],
          "keyword": [
            "keyword"
          ],
          "function": [
            "entity.name.function"
          ],
          "type": [
            "entity.name.type"
          ],
          "variable": [
            "variable.other.readwrite"
          ],
          "property": [
            "support.type.property-name"
          ],
          "namespace": [
            "entity.name.type"
          ],
          "number": [
            "constant.numeric"
          ],
          "comment": [
            "comment"
          ]
        }
      },
      {
        "language": "bibtex",
        "scopes": {
          "texText": [
            "text.bibtex",
            "meta.embedded"
          ],
          "texLiteral": [
            "markup.raw",
            "meta.embedded"
          ],
          "texPath": [
            "string.other.path"
          ],
          "texMath": [
            "keyword.operator"
          ],
          "macro": [
            "entity.name.function.preprocessor"
          ],
          "keyword": [
            "keyword"
          ],
          "function": [
            "entity.name.function"
          ],
          "type": [
            "entity.name.type"
          ],
          "variable": [
            "variable.other.readwrite"
          ],
          "property": [
            "support.type.property-name"
          ],
          "namespace": [
            "entity.name.type"
          ],
          "number": [
            "constant.numeric"
          ],
          "comment": [
            "comment"
          ]
        }
      }
    ]
  },
  "texLsServerVersion": "0.1.4",
  "icon": "images/icon.png",
  "homepage": "https://github.com/backmatter/tex-ls",
  "bugs": {
    "url": "https://github.com/backmatter/tex-ls/issues"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "uuid": "^11.1.1"
  }
}
