{
  "initialize": {
    "capabilities": {
      "general": {
        "positionEncodings": [
          "utf-8"
        ]
      },
      "textDocument": {
        "semanticTokens": {
          "tokenTypes": [
            "macro",
            "variable"
          ],
          "tokenModifiers": [],
          "formats": [
            "relative"
          ],
          "requests": {
            "full": true,
            "range": true
          }
        },
        "rangeFormatting": {
          "rangesSupport": true
        },
        "signatureHelp": {
